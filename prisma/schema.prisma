generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon on Vercel: pooled connection for the app, direct connection for migrations
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  icon      String    @default("Tag")
  color     String    @default("#10b981")
  budget    Float?
  isDefault Boolean   @default(false)
  expenses  Expense[]
  createdAt DateTime  @default(now())
}

model Expense {
  id           String   @id @default(cuid())
  amount       Float
  merchant     String
  date         String // YYYY-MM-DD in the user's local calendar
  description  String?
  items        String? // JSON string: [{ name, price, qty? }]
  receiptImage String? // compressed data URL of the scanned receipt
  source       String   @default("manual") // manual | scan | demo
  isDemo       Boolean  @default(false)
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date])
  @@index([categoryId])
}
